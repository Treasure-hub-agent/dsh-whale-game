{
  "name": "dsh-whale-game",
  "version": "0.1.0",
  "description": "大肥鱼游戏厅 —— DeepSeek Harness 插件：和你桌边的那个 Agent 一起玩六款小游戏",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Whale Arcade contributors",
  "homepage": "https://github.com/Treasure-hub-agent/dsh-whale-game#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Treasure-hub-agent/dsh-whale-game.git"
  },
  "bugs": {
    "url": "https://github.com/Treasure-hub-agent/dsh-whale-game/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "whale-game",
    "ai-playground",
    "board-game",
    "human-vs-ai",
    "mcp",
    "agent-game"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e-local.mjs",
    "check": "node build.mjs && node scripts/smoke.mjs && tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  }
}
